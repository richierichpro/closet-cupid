# Copy this file to .env and paste your key. Never commit .env.
SERPAPI_KEY=
YOUCAM_API_KEY=
ANTHROPIC_API_KEY=
# Only for a user-level key (sk-ant-usr-...) that isn't scoped to a workspace:
ANTHROPIC_WORKSPACE_ID=
# Max real SerpAPI calls per 24 hours (cached searches are free).
SERPAPI_DAILY_LIMIT=100
